# Copy this file to .env and fill in real values before deploying.
FLASK_ENV=production
FLASK_DEBUG=false

# REQUIRED in production - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-hex-string

# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///instance/union.db

# Session cookie security - set true when serving over HTTPS
SESSION_COOKIE_SECURE=true

# --- Optional integrations (app degrades gracefully if left blank) ---
# Weather (used only if you add weather features to worker dashboard)
OPENWEATHERMAP_API_KEY=

# Email for password reset (Flask-Mail style SMTP)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@yourunion.org

# SMS/OTP (Twilio) for forgot-password by phone
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

LOG_LEVEL=INFO
